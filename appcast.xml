<?xml version="1.0" encoding="utf-8"?>
<!--
  The update feed of this fork.

  It is deliberately *not* upstream's feed: a build of this fork that updates itself from
  p0deje/Maccy would replace every performance change in this repository (see docs/releasing.md).

  There are no <item> elements yet, which is valid and means "no update available". Add one per
  release, signed with this fork's own Sparkle key — docs/releasing.md, step 4, has the recipe.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>Maccy</title>
    <link>https://raw.githubusercontent.com/vernikr/Maccy/master/appcast.xml</link>
    <description>Most recent changes with links to updates.</description>
    <language>en</language>
  </channel>
</rss>
